{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/predict.py": {
      "includeFiles": "{model/**,sevrage_ai/**}",
      "excludeFiles": "{public/**,**/__pycache__/**,**/*.pyc}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/config.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
